{
	"version": 3,
	"configurePresets":
	[
		{
			"name": "cmake-dev",
			"hidden": true,
			"binaryDir": "${sourceDir}/build",
			"warnings":
			{
				"dev": true,
				"deprecated": true
			},
			"errors":
			{
				"deprecated": true
			}
		},
		{
			"name": "vcpkg",
			"hidden": true,
			"cacheVariables":
			{
				"CMAKE_TOOLCHAIN_FILE":
				{
					"type": "STRING",
					"value": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
				}
			}
		},
		{
			"name": "windows",
			"hidden": true,
			"cacheVariables": {
				"CMAKE_MSVC_RUNTIME_LIBRARY":
				{
					"type": "STRING",
					"value": "MultiThreaded$<$<CONFIG:Debug>:Debug>"
				},
				"VCPKG_TARGET_TRIPLET":
				{
					"type": "STRING",
					"value": "x64-windows-static"
				}
			}
		},
		{
			"name": "vs2026-windows",
			"generator": "Visual Studio 18 2026",
			"toolset": "v145",
			"architecture":
			{
				"value": "x64",
				"strategy": "set"
			},
			"cacheVariables":
			{
				"CMAKE_CXX_FLAGS": "/EHsc /MP /W4",
				"CMAKE_CXX_FLAGS_RELEASE": "/O2 /DNDEBUG"
			},
			"inherits":
			[
				"cmake-dev",
				"vcpkg",
				"windows"
			]
		}
	],
	"buildPresets":
	[
		{
			"name": "Release",
			"configurePreset": "vs2026-windows",
			"configuration": "Release"
		},
		{
			"name": "Debug",
			"configurePreset": "vs2026-windows",
			"configuration": "Debug"
		}
	]
}
